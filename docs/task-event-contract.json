{
  "description": "Notification-phase contract for the Android TaskReducer against OpenCode 2.x `/api/event` frames. 'data' is the event's data object; 'expectedPhase' is the phase after applying the event, a no-op transition keeps the previous phase (or IDLE when there was none).",
  "phases": ["IDLE", "THINKING", "TOOL", "SUBAGENT", "TESTING", "WAITING_PERMISSION", "WAITING_QUESTION", "COMPLETED", "FAILED", "ABORTED", "DISCONNECTED"],
  "cases": [
    { "name": "permission asked moves to waiting",
      "type": "permission.asked", "data": { "id": "per_1", "sessionID": "s", "action": "bash", "resources": [] },
      "previous": null, "expectedPhase": "WAITING_PERMISSION" },
    { "name": "form created moves to waiting",
      "type": "form.created", "data": { "form": { "id": "frm_1", "sessionID": "s", "fields": [] } },
      "previous": null, "expectedPhase": "WAITING_QUESTION" },
    { "name": "permission reply resumes running",
      "type": "permission.replied", "data": { "sessionID": "s", "requestID": "per_1", "reply": "once" },
      "previous": "WAITING_PERMISSION", "expectedPhase": "THINKING" },
    { "name": "form reply resumes running",
      "type": "form.replied", "data": { "id": "frm_1", "sessionID": "s", "answer": {} },
      "previous": "WAITING_QUESTION", "expectedPhase": "THINKING" },
    { "name": "execution start runs",
      "type": "session.execution.started", "data": { "sessionID": "s" },
      "previous": null, "expectedPhase": "THINKING" },
    { "name": "execution success completes even with background work",
      "type": "session.execution.succeeded", "data": { "sessionID": "s" },
      "previous": "THINKING", "expectedPhase": "COMPLETED" },
    { "name": "execution failure fails",
      "type": "session.execution.failed", "data": { "sessionID": "s", "error": { "type": "provider", "message": "boom" } },
      "previous": "TOOL", "expectedPhase": "FAILED" },
    { "name": "user interruption stops",
      "type": "session.execution.interrupted", "data": { "sessionID": "s", "reason": "user" },
      "previous": "THINKING", "expectedPhase": "ABORTED" },
    { "name": "shutdown keeps the running turn",
      "type": "session.execution.interrupted", "data": { "sessionID": "s", "reason": "shutdown" },
      "previous": "TOOL", "expectedPhase": "TOOL" },
    { "name": "reasoning stays running",
      "type": "session.reasoning.started", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "ordinal": 0 },
      "previous": "TOOL", "expectedPhase": "THINKING" },
    { "name": "plain tool call is a tool step",
      "type": "session.tool.called", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "id": "call_1", "name": "read", "input": { "path": "a.kt" }, "executed": true },
      "previous": "THINKING", "expectedPhase": "TOOL" },
    { "name": "shell running a test command is testing",
      "type": "session.tool.called", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "id": "call_2", "name": "shell", "input": { "command": "./gradlew test" }, "executed": true },
      "previous": "THINKING", "expectedPhase": "TESTING" },
    { "name": "subagent call is a subagent step",
      "type": "session.tool.called", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "id": "call_3", "name": "subagent", "input": { "agent": "explore", "description": "Find", "prompt": "x" }, "executed": true },
      "previous": "THINKING", "expectedPhase": "SUBAGENT" },
    { "name": "a tool step cannot resume a finished run",
      "type": "session.tool.called", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "id": "call_4", "name": "read", "input": {}, "executed": true },
      "previous": "COMPLETED", "expectedPhase": "COMPLETED" },
    { "name": "streaming text does not change the phase",
      "type": "session.text.delta", "data": { "sessionID": "s", "assistantMessageID": "msg_a", "ordinal": 0, "delta": "x" },
      "previous": "TOOL", "expectedPhase": "TOOL" },
    { "name": "a provider error is not the turn outcome",
      "type": "session.error", "data": { "sessionID": "s", "error": { "name": "ProviderError", "message": "boom" } },
      "previous": "THINKING", "expectedPhase": "THINKING" }
  ]
}
